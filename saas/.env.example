# Copy to .env and fill in before running for real. Never commit the real .env.

# Postgres connection string. On Render, attaching a free Postgres database
# sets this automatically -- you don't need to fill it in yourself there.
# Locally, point it at whatever Postgres instance you're testing against:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Stripe (test mode keys first -- from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a recurring $4.99/mo Price in the Stripe dashboard, paste its id here
STRIPE_PRICE_ID=price_...

# The public URL this app is served from (used for Stripe redirect + CSRF origin check)
PUBLIC_BASE_URL=http://localhost:8000

# Random long string protecting /api/admin/* -- generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# How many predictions free (non-subscribed) accounts see per day
FREE_DAILY_LIMIT=3
