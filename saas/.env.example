# Copy to .env and fill in before running for real. Never commit the real .env.

# Postgres connection string. On Render, attaching a free Postgres database
# sets this automatically -- you don't need to fill it in yourself there.
# Locally, point it at whatever Postgres instance you're testing against:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Stripe (test mode keys first -- from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a recurring $4.99/mo Price in the Stripe dashboard, paste its id here
STRIPE_PRICE_ID=price_...

# The public URL this app is served from (used for Stripe redirect + CSRF origin check)
PUBLIC_BASE_URL=http://localhost:8000

# Random long string protecting /api/admin/* -- generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Also reused (unmodified) as the signing key for the /unlock cookie below --
# not exposed by that reuse, just used as an HMAC key.
ADMIN_TOKEN=

# How many predictions the free preview shows before the rest are locked
FREE_DAILY_LIMIT=3

# ---------- Manual paywall (no accounts): pay via Selar, message WhatsApp, ----------
# ---------- get this passcode, unlock the site for UNLOCK_TTL_DAYS.        ----------
# The shared code you hand out over WhatsApp after confirming a Selar payment.
# Change it periodically if you're worried about it being passed around --
# there's no per-user tracking with this approach, that's the deliberate
# simplicity/security trade-off of a shared passcode over real accounts.
VIP_PASSCODE=

# Shown on the /unlock page. A wa.me link, e.g. https://wa.me/2348000000000
WHATSAPP_LINK=

# Shown on the /unlock page. Your Selar product checkout URL.
SELAR_LINK=
